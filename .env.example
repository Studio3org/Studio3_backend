# Copy to .env.development / .env.production. Do not commit secrets.
#
# Verified against src/shared/config/settings.py by tests/unit/test_config_contract.py:
# every variable the code reads is listed here, and adding one without updating that
# registry fails the build.
#
# [required] = the app refuses to boot in production without it.
# [staging]  = also required on the deployed test environment.

# --- Core ----------------------------------------------------------
# Which environment this process is running as.
FLASK_ENV=development
# Port for the dev server (run.py). Render supplies its own.
PORT=9000
# PostgreSQL connection string. [required] [staging]
DATABASE_URL=
# Redis connection string — sessions, OTP, Socket.IO pub/sub. [required] [staging]
REDIS_URL=

# --- Auth ----------------------------------------------------------
# Signs the admin session cookie, which gates refunds and payouts. [required] [staging]
SECRET_KEY=
# Signs API access tokens. [required] [staging]
JWT_SECRET=
# Access token lifetime.
JWT_ACCESS_EXPIRY_MINUTES=15
# bcrypt cost factor for password hashing.
SALT_ROUNDS=10

# --- Web -----------------------------------------------------------
# Canonical web origin. Always CORS-allowed; used in share links. [required] [staging]
FRONTEND_URL=
# Extra browser origins, comma-separated.
CORS_ORIGINS=
# This service's own public URL, for links it generates.
BACKEND_URL=

# --- Payments (Stripe) ---------------------------------------------
# Stripe API key. Unset = dev mode, checkout auto-confirms. [required]
STRIPE_SECRET_KEY=
# Webhook signing secret(s), comma-separated: platform endpoint, Connect endpoint. [required]
STRIPE_WEBHOOK_SECRET=
# ISO currency for charges and payouts.
PLATFORM_CURRENCY=usd
# Commission on original art, in basis points (2000 = 20%).
PLATFORM_COMMISSION_BPS=2000
# Commission on event tickets, in basis points (800 = 8%).
PLATFORM_TICKET_COMMISSION_BPS=800
# Country for new Stripe Connect Express accounts.
CONNECT_ACCOUNT_COUNTRY=US
# Base for Connect return/refresh redirects.
CONNECT_ONBOARDING_BASE_URL=https://studio-3.co/connect

# --- Storage (AWS S3) ----------------------------------------------
# AWS credentials for S3 and SES. [required]
AWS_ACCESS_KEY_ID=
# AWS credentials for S3 and SES. [required]
AWS_SECRET_ACCESS_KEY=
# AWS region for S3 and SES.
AWS_REGION=us-east-1
# Media bucket. [required]
# Also accepted: STUDIO3_S3_BUCKET
S3_BUCKET=
# Public base URL media is served from. [required]
# Also accepted: STUDIO3_S3_PUBLIC_BASE_URL
S3_PUBLIC_BASE_URL=
# Where /api/media/local writes when S3 is unconfigured.
LOCAL_MEDIA_DIR=

# --- Notifications -------------------------------------------------
# Verified SES sender. Unset = OTP and reset emails are skipped.
SES_FROM_EMAIL=
# Path to the FCM service account JSON.
FIREBASE_SERVICE_ACCOUNT_PATH=
# Inline FCM service account JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Background jobs -----------------------------------------------
# Overrides the broker URL. Unset = REDIS_URL with CELERY_REDIS_DB as its index.
CELERY_BROKER_URL=
# Redis database index for the job queue. Kept off the cache index so an eviction policy cannot drop queued jobs.
CELERY_REDIS_DB=1

# --- Share links ---------------------------------------------------
# iOS listing, for the 'get the app' interstitial.
APP_STORE_URL=
# Android listing, for the 'get the app' interstitial.
PLAY_STORE_URL=

# --- Observability -------------------------------------------------
# Error tracking. Unset = Sentry is not initialised at all.
SENTRY_DSN=

# --- app association (deep links) -------------------------------------------------------
# These make a shared https:// link or a scanned QR open the app instead of a browser. The
# backend serves /.well-known/apple-app-site-association and /.well-known/assetlinks.json
# from these values, so whichever host serves the API serves the association files too.
#
# All optional: unset simply means association is off. The studio3:// custom scheme still
# works and needs no verification, which is what the QR codes fall back to.
#
# Apple Developer Team ID (developer.apple.com -> Membership). Also visible in Xcode, and
# already present in ios/Runner.xcodeproj as DEVELOPMENT_TEAM.
IOS_TEAM_ID=
IOS_BUNDLE_ID=com.studio3.discover
ANDROID_PACKAGE=com.studio3.discover
# SHA-256 signing fingerprints, comma-separated. List every key whose builds should verify:
# the release keystore, the debug keystore that internally-shared APKs are signed with, and
# Google's own re-signing key once the app is on Play. One key means links verify for some
# of your builds and silently not for others.
#   keytool -list -v -keystore <path> -alias <alias> | grep SHA256
ANDROID_CERT_FINGERPRINTS=
