# Copy to .env.development / .env.production. Do not commit secrets.

PORT=9000
FLASK_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/flask_app_dev

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY_MINUTES=15
SALT_ROUNDS=10
SECRET_KEY=change-me-in-production

FRONTEND_URL=http://localhost:3000

# AWS S3 (optional in local/dev — when unset, presign uses /api/media/local).
# On Render these must ALL be set together or uploads return 503:
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, S3_BUCKET, S3_PUBLIC_BASE_URL
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# AWS SES (optional — OTP/reset emails skipped when unset; must be a verified SES sender identity)
SES_FROM_EMAIL=

# Firebase Cloud Messaging (push notifications — optional, skipped when unset)
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Stripe (placeholder — payment integration not yet built; leave unset)
STRIPE_SECRET_KEY=
