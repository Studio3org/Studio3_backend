# Copy to deploy/config.env and fill in. Never commit config.env.
#   cp deploy/config.env.example deploy/config.env
#
# Everything below "App configuration" is copied verbatim into /opt/studio3/.env.production
# by deploy.sh. The app's own contract lives in src/shared/config/settings.py — anything
# marked [required] there makes the service refuse to boot when it is empty, so deploy.sh
# checks them before it touches the server.

# --- AWS ---
AWS_REGION=us-east-1
AWS_PROFILE=default

# Name prefix for all resources (safe to leave as-is)
PROJECT=studio3

# EC2
# t3.small (2 GB) now runs gunicorn + a Celery worker + beat + nginx. It fits, but
# t3.medium is the comfortable size once real traffic and image uploads arrive.
EC2_INSTANCE_TYPE=t3.small
# Amazon Linux 2023 — leave empty to auto-resolve latest AMI for AWS_REGION
EC2_AMI_ID=
# Existing key pair name in this region (create in console if needed)
EC2_KEY_NAME=studio3-key
# Your public IP for SSH (CIDR). Example: 203.0.113.10/32
SSH_CIDR=

# RDS Postgres
RDS_INSTANCE_CLASS=db.t4g.micro
RDS_ENGINE_VERSION=16.6
RDS_DB_NAME=studio3
RDS_USERNAME=studio3
# Strong password, URL-safe (avoid @ : / # ? &). Generate: openssl rand -base64 24
RDS_PASSWORD=
RDS_ALLOCATED_STORAGE=20

# ElastiCache Redis
CACHE_NODE_TYPE=cache.t3.micro
CACHE_ENGINE_VERSION=7.1

# Domain (buy/register first, or use an existing domain)
# Example: api.yourbrand.com
DOMAIN=
# Parent zone if different (e.g. yourbrand.com). Auto-derived from DOMAIN if empty.
HOSTED_ZONE_NAME=
# Email for Let's Encrypt (required for SSL)
SSL_EMAIL=

# After create-infra.sh: pasted automatically
EC2_HOST=
EC2_USER=ec2-user
DEPLOY_SSH_KEY=~/.ssh/studio3-key.pem
DATABASE_URL=
REDIS_URL=

# =====================================================================
# App configuration — copied to .env.production. Mirrors .env.example.
# =====================================================================

# --- Auth --- (deploy.sh generates and pins JWT_SECRET / SECRET_KEY if empty)
# Leave blank on the first deploy and deploy.sh generates them and writes them
# back here. Do not clear them afterwards: changing either signs out every user,
# and changing SECRET_KEY also ends every admin session.
#   openssl rand -hex 32
JWT_SECRET=
SECRET_KEY=
JWT_ACCESS_EXPIRY_MINUTES=15
SALT_ROUNDS=10

# --- Web ---
# [required] Canonical web origin, e.g. https://app.yourbrand.com
FRONTEND_URL=
# Extra browser origins, comma-separated.
CORS_ORIGINS=
# This service's own public URL. Left empty, deploy.sh derives https://$DOMAIN.
BACKEND_URL=

# --- Payments (Stripe) ---
# [required] Live secret key.
STRIPE_SECRET_KEY=
# [required] Comma-separated: platform endpoint secret, Connect endpoint secret.
# Without it every webhook fails signature checks and paid orders are never marked paid,
# so the app refuses to boot rather than serve a silently broken checkout.
STRIPE_WEBHOOK_SECRET=
PLATFORM_CURRENCY=usd
# Basis points. 2000 = 20% on original art, 800 = 8% on event tickets.
# Required, with no default anywhere: 2000 is 20% and 1000 is 10%, and the
# difference is half of what an artist earns. Staging currently runs 1000.
PLATFORM_COMMISSION_BPS=
PLATFORM_TICKET_COMMISSION_BPS=800
CONNECT_ACCOUNT_COUNTRY=US
# Where Stripe returns an artist after Connect onboarding. Must be a URL that
# actually resolves — the default below does not point anywhere yet.
CONNECT_ONBOARDING_BASE_URL=

# --- Storage (S3 + SES) ---
# [required] All four.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=
# Only used when S3 is unconfigured; leave empty in production.
LOCAL_MEDIA_DIR=

# --- Notifications ---
# Verified SES sender. Unset = OTP and password-reset emails are skipped.
SES_FROM_EMAIL=
# Inline FCM service account JSON (single line) for push.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Background jobs ---
# Unset = REDIS_URL with CELERY_REDIS_DB as its index. Keep the job queue off the cache
# index so an eviction cannot drop queued jobs.
CELERY_BROKER_URL=
CELERY_REDIS_DB=1

# --- Share links / deep links ---
APP_STORE_URL=
PLAY_STORE_URL=
# Apple Developer Team ID; enables /.well-known/apple-app-site-association.
IOS_TEAM_ID=
IOS_BUNDLE_ID=com.studio3.discover
ANDROID_PACKAGE=com.studio3.discover
# SHA-256 fingerprints, comma-separated: release keystore, debug keystore, and Play's
# re-signing key once the app is listed.
ANDROID_CERT_FINGERPRINTS=

# --- Observability ---
# Unset = Sentry is not initialised at all.
SENTRY_DSN=

# --- First admin -----------------------------------------------------------------
# There is no self-serve admin signup, so a brand new environment has nobody able to
# reach the ops console. Set these for the first deploy and it creates the account.
#
# Only ever creates. If the email already belongs to an account it is promoted to
# admin and its password is left alone, so re-deploying cannot undo a rotation.
#
# Clear ADMIN_PASSWORD once you have signed in and changed it. A live credential in a
# deploy config is a copy of the keys to the refund button.
ADMIN_EMAIL=
ADMIN_PASSWORD=
